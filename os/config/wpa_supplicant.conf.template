# wpa_supplicant configuration template - MULE
#
# Configures station and 802.11s mesh association for the radio bearers.
#
# STATUS: TEMPLATE. Every value below is TBD. This file is an input to
# configuration generation, not a file to be edited on a node.
#
# REGION IS A PARAMETER. No frequency, channel, bandwidth or transmit power
# appears in this file. Those come from regions/<region-id>/profile.yml. See
# regions/README.md and REGULATORY.md. A generated channel outside the region's
# permitted set is a regulatory problem, not a bug.
#
# LOGICAL, NOT PHYSICAL. Blocks below are named for logical radio functions.
# Whether two functions share a physical radio is TBR-RF-03; see FML-ADR-045.
#
# Trades: TBR-RF-01 (high-rate mesh implementation)
#         TBR-RF-02 (sub-GHz coexistence controls)
#         TBR-RF-03 (AP and mesh radio consolidation)
#         TBR-LINUX-01 (driver capabilities; whether these options are honoured)
#
# Whether the HaLow driver honours standard wpa_supplicant mesh options at all
# is UNVERIFIED. TBR-LINUX-01 may show that vendor tooling is required instead,
# in which case this template is replaced rather than filled in.

ctrl_interface=TBD
# Group permitted to control the supplicant. Rootless services must not need
# root to read radio state; see the hardware abstraction rule in AGENTS.md.
ctrl_interface_group=TBD

# Regulatory domain. Sourced from the region profile, never hardcoded.
country=TBD

# --- Sub-GHz HaLow bearer: range-oriented IP MANET -------------------------
# 802.11s mesh association. Routing is batman-adv/BATMAN-V; see FML-ADR-024
# and batman-adv.conf.template.
#
# network={
#   ssid="TBD"              # Mesh identifier. From the mission package.
#   mode=5                  # 5 = 802.11s mesh point
#   frequency=TBD           # FROM REGION PROFILE. Never a literal here.
#   key_mgmt=SAE            # NOT TBD. FML-ADR-061 decides it.
#   sae_password=TBD        # The credential. See below: its source is undecided.
# }
#
# MESH SECURITY IS DECIDED. FML-ADR-061 requires key_mgmt=SAE, so peers
# authenticate by SAE and Authenticated Mesh Peering Exchange before a peer link
# reaches ESTAB. An open field mesh is prohibited. Measured on hwsim: a node
# without the credential never reaches ESTAB and gets 100% packet loss, and
# test/bench/keyed-mesh.sh reproduces it. The key is the admission control, and
# issuing it is the admission decision.
#
# sae_password rather than psk. Both appear in wpa_supplicant's own mesh
# examples; the shipped configuration reference says psk "follows the WPA-PSK
# constraints (8..63 characters) even though SAE passwords do not have such
# constraints". sae_password is what test/bench/keyed-mesh.sh exercises.
#
# ONE CREDENTIAL PER MESH, and no per-device keys. A node configured with two
# sae_password entries and two sae_password_id identifiers did not authenticate
# a peer holding the second credential; every cross-credential pairing stayed at
# LISTEN. So a captured node yields the mesh credential and revoking one node
# means rekeying every node. FML-ADR-061 accepts that cost explicitly and
# TBR-SEC-01 holds the credential as a protected asset.
#
# WHERE THE CREDENTIAL COMES FROM IS NOT DECIDED, and this file will not
# pretend otherwise. FML-ADR-061 says in its own accepted cost that "rekeying
# has no mechanism" and that "nothing in this program distributes or rotates a
# mesh credential".
#
# The obvious answer, that it comes from the mission package, is not currently
# available: mission/schema/mission-package.schema.json sets
# additionalProperties: false at the root and on network, and its ap_ssid entry
# says the passphrase "is NOT part of this schema and never appears in a
# committed package". A package cannot carry a credential field, and
# mission/local/ validates against the same schema.
#
# hostapd.conf.template states that the access point passphrase "comes from the
# mission configuration package at generation time", which the paragraph above
# makes impossible. That is a real inconsistency and it is not resolved here.
# The same gap covers both credentials, and TBR-SEC-01 is where it belongs.

# --- Conventional Wi-Fi: high-throughput inter-node bearer -----------------
# Whether this uses 802.11s and joins the same batman-adv mesh, uses a separate
# mesh, or uses a different mechanism entirely is TBR-RF-01.
#
# network={
#   ssid="TBD"
#   mode=TBD                # TBR-RF-01
#   frequency=TBD           # FROM REGION PROFILE
#   key_mgmt=TBD
# }

# --- Notes ------------------------------------------------------------------
# Bring-up ordering is not captured here. A mesh interface configured before
# its driver has finished initialising fails in ways that look like a radio
# fault. Ordering belongs to the systemd unit structure and is TBD.
#
# Where configuration is adopted from the upstream MANET reference project,
# cite the source in a comment on the adopting line. See FML-ADR-023.
