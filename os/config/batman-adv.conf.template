# batman-adv configuration template - MULE
#
# Configures layer 2 mesh routing. batman-adv in BATMAN-IV mode is the baseline
# IP MANET routing for the range-oriented sub-GHz bearer; see FML-ADR-053,
# which supersedes FML-ADR-024 on the algorithm and nothing else.
#
# STATUS: TEMPLATE. Values marked TBD are undecided. Values that are set have
# been observed on a running three-node mesh by
# .github/workflows/mesh-probe.yml, which is SIMULATED: veth is a perfect wire
# and nothing here has met a radio. This file is an input to configuration
# generation, not a file to be edited on a node.
#
# batman-adv routes Ethernet frames rather than IP packets, so the mesh appears
# as one flat broadcast domain. Two consequences that shape everything else:
#   - Services relying on link-local discovery work without a discovery proxy.
#   - Broadcast and multicast traffic reaches every node over a low-rate
#     bearer, and controlling that is real work this file does not yet solve.
#
# Trades: TBR-RF-01 (whether the high-rate bearer joins the same mesh)
#         TBR-NET-01 (field address prefix)
#         TBR-LINUX-01 (whether the driver supplies a throughput estimate)
#
# batman-adv and batctl are part of the compatibility set and are pinned in
# os/kernel/PINS.md. They must match. See FML-ADR-040.

# --- Routing algorithm ------------------------------------------------------
# BATMAN-IV uses a transmit-quality metric derived from packet loss.
#
# FML-ADR-053 selects it over BATMAN-V, which the stock distribution module does
# not provide: loading batman-adv 2025.3 and asking for BATMAN_V reports
# "Routing algorithm 'BATMAN_V' is not supported". It is the kernel build option
# CONFIG_BATMAN_ADV_BATMAN_V, and enabling it means a custom kernel or the
# out-of-tree module in the compatibility set, permanently.
#
# That cost was being paid for a metric whose benefit is contingent: BATMAN-V
# needs a usable throughput estimate from the driver, and whether the
# out-of-tree HaLow driver supplies one is still unknown under TBR-LINUX-01.
#
# Must be set BEFORE any interface is added to the mesh.
routing_algo=BATMAN_IV

# --- Mesh interface ---------------------------------------------------------
mesh_interface=TBD             # e.g. bat0

# Interfaces attached to the mesh. Which bearers join is TBR-RF-01: the sub-GHz
# bearer certainly, the high-rate inter-node bearer possibly.
#
# The EUD access point does NOT join the mesh. It is a separate logical radio
# function; see FML-ADR-045.
hard_interfaces=TBD

# --- Hard interface MTU -----------------------------------------------------
# batman-adv prepends its own header, so a 1500 byte hard interface cannot carry
# a full-size frame without fragmenting it at layer 2. The module says so on
# every interface add, and names the figure:
#
#   batman_adv: bat0: The MTU of interface veth12 is too small (1500) to handle
#   the transport of batman-adv packets. Packets going over this interface will
#   be fragmented on layer2 which could impact the performance. Setting the MTU
#   to 1560 would solve the problem.
#
# Observed, not derived. It applies to every interface added to the mesh, and
# bat0 itself then presents 1500 to IP, which is what everything above expects.
#
# Whether the selected radios can carry a 1560 byte frame is NOT established.
# An interface that cannot will fragment regardless, and TBR-RF-01 and
# TBR-LINUX-01 own that question.
hard_interface_mtu=1560

# --- Parameters -------------------------------------------------------------
orig_interval=TBD              # Originator message interval, ms. Default 1000.
                               #
                               # MEASURED NOT TO AFFECT WARM-UP, which was the
                               # reason to touch it. Time from mesh formation to
                               # first reply, cold, three nodes on veth:
                               #
                               #   1000ms  24s     500ms  22s     200ms  23s
                               #
                               # So the delay before a node can reach a peer is
                               # not originator propagation, and lowering this
                               # buys nothing while costing airtime, which is
                               # the scarce thing on the real bearer.
                               #
                               # Still TBD, because the question this value
                               # actually decides is convergence after a
                               # TOPOLOGY CHANGE on a lossy link, which veth
                               # cannot pose. TBR-RF-01 owns that.

hop_penalty=TBD                # TBR-RF-01

gw_mode=TBD                    # Gateway mode. Local-first means there is
                               # usually no gateway; see docs/NON-GOALS.md.

multicast_mode=0               # Multicast optimisation OFF.
                               #
                               # It suppresses flooding to nodes not known to
                               # want a group, which is an optimisation for a
                               # mesh-wide multicast story this program does not
                               # have: FML-ADR-026 keeps LoRa/Meshtastic a
                               # separate non-IP plane, so there is no
                               # cross-bearer multicast to optimise for.
                               #
                               # A REASONED DEFAULT, NOT A MEASURED ONE. The
                               # mesh does carry traffic with it disabled, which
                               # is not the same as evidence that disabling it
                               # helps. Revisit under TBR-RF-01 once
                               # broadcast load on a real bearer is measured,
                               # since FML-ADR-024 already warns that ordinary
                               # EUD broadcast is not free.

# --- Announce, do not wait to be discovered ---------------------------------
# MEASURED. A node that sends an unsolicited ARP when bat0 comes up reaches its
# peers about six seconds sooner than one that waits to be asked:
#
#   gratuitous ARP off   28s from converged originators to first reply
#   gratuitous ARP on    22s
#
# Replicated at both distributed_arp_table settings. Three frames per node at
# bring-up, and it belongs in the interface unit rather than a daemon:
#
#   arping -A -c 3 -I bat0 <address>
#
# The remaining ~22s is NOT ARP, NOT the distributed ARP table, and NOT the
# originator interval. All three were measured and only gratuitous ARP moved it.
#
# Note the measurement's own limit before quoting the figure: the probe polls
# with two one-second pings and a one-second sleep, so a failing iteration costs
# about three seconds and 22s is roughly seven iterations. The true time is
# somewhere inside that granularity. It is a bound, not a stopwatch.
gratuitous_arp_on_bringup=yes

distributed_arp_table=0        # Distributed ARP table OFF.
                               #
                               # DAT answers ARP from a mesh-wide cache instead
                               # of flooding. That trades correctness under
                               # partition for airtime, and this system is built
                               # to partition: CONOPS section 29 prefers losing
                               # shared-service authority over serving divergent
                               # state, and a cached ARP answer from a node that
                               # has since become unreachable is the same shape
                               # of error one layer down.
                               #
                               # MEASURED TO MAKE NO DIFFERENCE to warm-up:
                               # 28s off and 28s on without gratuitous ARP, 22s
                               # off and 22s on with it. So this setting rests
                               # entirely on the partition argument above and
                               # not on any performance claim. It was disabled
                               # here on that reasoning before it was measured,
                               # which was not justified at the time.

fragmentation=TBD
distributed_arp_table=TBD
bridge_loop_avoidance=TBD

# --- Notes ------------------------------------------------------------------
# Bring-up ordering matters: batman-adv attached to an interface that is not
# yet up fails in ways that look like a radio fault. Ordering belongs to the
# systemd unit structure and is TBD, pending TBR-LINUX-01.
#
# Where configuration is adopted from the upstream MANET reference project,
# cite the source in a comment on the adopting line. See FML-ADR-023.
#
# Scaling is unmeasured. The node count at which a flat layer 2 mesh over this
# bearer stops working is unknown; FML-ADR-024 records that as an accepted cost.
