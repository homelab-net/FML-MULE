#!/usr/sbin/nft -f
# nftables configuration template - MULE
#
# Configures the host firewall and forwarding policy between the mesh, the EUD
# access point, and the services running on the node.
#
# STATUS: TEMPLATE. Every value below is TBD. This file is an input to
# configuration generation, not a file to be edited on a node. It is not
# loadable as written.
#
# Trades: TBR-NET-01 (field address prefix and addressing scheme)
#         TBR-TAK-01 (what the mission-service plane exposes and to whom)
#         TBR-RF-03 (whether AP and mesh share an interface)
#
# THE BOUNDARY THIS FILE DEFENDS
#
# The EUD access point admits end user devices that are outside the node's
# trust boundary. THREAT_MODEL.md records that MULE cannot detect or contain a
# compromised EUD. This firewall is where that containment is attempted.
#
# It does NOT defend against an admitted participant. Peer traffic on a shared
# operational domain is visible to all authenticated participants by design;
# that is a stated condition, not a defect.
#
# DEFAULT DENY
#
# Every chain below defaults to drop. A rule is added because something needs
# to pass, and the reason is written on the rule. A firewall whose rules nobody
# can justify line by line is a firewall nobody can tighten later.

table inet filter {
  # Sets are populated from the region profile and the mission configuration
  # package at generation time. Never literals here; see TBR-NET-01.
  #
  # set mesh_prefix { type ipv6_addr; flags interval; elements = { TBD } }
  # set eud_prefix  { type ipv6_addr; flags interval; elements = { TBD } }

  chain input {
    type filter hook input priority filter; policy drop;

    # TBD: loopback.
    # TBD: established and related.
    # TBD: ICMP, including what is required for path MTU discovery. Dropping
    #      ICMP on a mesh with varying MTU is a way to create failures that
    #      appear only for large transfers.
    # TBD: batman-adv control traffic. Which ethertype and on which
    #      interfaces depends on TBR-RF-01.
    # TBD: DHCP and DNS from the EUD access point only. See
    #      dnsmasq.conf.template.
    # TBD: mission services, per service, from the mesh and from the EUD
    #      access point separately. The two are different trust levels and are
    #      not to be collapsed into one rule. Which services and which ports
    #      is TBR-TAK-01 and services/catalog/.
    # TBD: administrative access. Whether any exists on a field node, and over
    #      which interface, is an open question with THREAT_MODEL.md
    #      consequences: an administrative path is a capture-time asset.
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    # DECIDED: an EUD on the access point is forwarded to the WAN uplink and
    #          receives general IP connectivity through it. FML-ADR-068. The
    #          Program Owner accepted the exposure: a device the node cannot
    #          vet or contain is given reach to the uplink and thus the overlay
    #          (FML-ADR-039). THREAT_MODEL.md records the consequence.
    #          Interface names are TBR-LINUX-01.
    #   iifname $AP_IFACE  oifname $WAN_IFACE accept
    #   iifname $WAN_IFACE oifname $AP_IFACE  ct state established,related accept
    #          The masquerade in `table ip nat` below is REQUIRED alongside
    #          these: the bench proved masquerade alone does not pass traffic
    #          while this policy is drop. This path is suppressed under an
    #          emission or mission profile that forbids WAN emission, because an
    #          EUD's uplink traffic makes the node transmit; see mission/profiles/.
    #
    # TBD: whether EUD traffic is forwarded onto the MESH at all, distinct from
    #      the uplink decided above, or whether an EUD reaches only services on
    #      its own node and the uplink. This is a significant architectural
    #      question and is not decided. It interacts with TBR-TAK-01 and with
    #      the ap_isolate setting in hostapd.conf.template.
    # TBD: mesh to mesh forwarding. Note that batman-adv routes at layer 2,
    #      so much inter-node traffic does not traverse this chain at all.
    #      Do not assume this chain sees the mesh.
  }

  chain output {
    type filter hook output priority filter; policy drop;

    # TBD: default-deny on output is deliberate and unusual. The reason is
    #      EMCON: a node in an emission-controlled profile must not emit, and
    #      a service that transmits despite the profile is a safety problem,
    #      not a bug. See mission/profiles/ and THREAT_MODEL.md.
    #      Whether this is enforceable here or belongs elsewhere is TBD.
  }
}

table ip nat {
  # Source NAT for the EUD-to-WAN passthrough decided in FML-ADR-068. REQUIRED
  # together with the forward accepts above: the bench proved neither the
  # masquerade nor the accepts passes traffic alone, because the filter forward
  # policy is drop.
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    # DECIDED: masquerade EUD traffic leaving the WAN uplink so an associated
    #          device reaches the internet through the node. FML-ADR-068.
    #          Interface and prefix names are TBR-LINUX-01 and TBR-NET-01.
    #   ip saddr $EUD_PREFIX oifname $WAN_IFACE masquerade
    #
    #          The match is the EUD prefix, NOT the mesh prefix, on purpose:
    #          FML-ADR-068 does not grant mesh-wide internet egress. A device
    #          reached across the mesh (another MULE, or its EUD) does not get
    #          the uplink through this rule. Mesh egress is a separate decision
    #          needing batman-adv gateway mode; see networkd.conf.template.
    #
    # This is IPv4 masquerade. TBR-NET-01 has not decided the address family;
    # if addressing is IPv6 the passthrough is routed, not masqueraded, and this
    # table changes shape. See interfaces.conf.template.
  }
}

# --- Notes ------------------------------------------------------------------
# Rootless Podman (FML-ADR-029) affects how service traffic appears here.
# Rootless networking and privileged port binding need explicit handling; see
# services/ingress/.
#
# No rule in this file may contain a real address, prefix, or credential. See
# SECURITY.md.
