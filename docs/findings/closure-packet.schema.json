{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feral-mule.invalid/schema/finding-closure-packet-1.0.json",
  "title": "FERAL MULE finding closure packet frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "scope",
    "governing_refs",
    "pre_fix_reproduction",
    "expected_failure",
    "implementation_commit",
    "files_changed",
    "tests",
    "environment",
    "artifacts",
    "date",
    "operator",
    "reviewer",
    "classification",
    "red_team_attempts",
    "residual_risks",
    "deferred_work",
    "closure_approved_by",
    "redaction_statement",
    "owner_approval_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "finding_id": {
      "type": "string",
      "pattern": "^(BASE|OSS|GAP|ENV|HW)-[0-9]{2}[A-Z]?$"
    },
    "scope": { "type": "string", "minLength": 1 },
    "governing_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pre_fix_reproduction": { "type": "string", "minLength": 1 },
    "expected_failure": { "type": "string", "minLength": 1 },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "exit_code"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "const": 0 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python", "tools"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "operator": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "classification": {
      "enum": ["UNVERIFIED", "SIMULATED", "HARDWARE-VERIFIED"]
    },
    "red_team_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "outcome"],
        "properties": {
          "attempt": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "deferred_work": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "closure_approved_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "redaction_statement": { "type": "string", "minLength": 1 },
    "owner_approval_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
