# One mission capability. Not loadable: the suffix is .target.disabled.
# A mission selects opentakserver. This target owns the internal units.
# Those units are not catalog services.
#
# The mesh interface this capability waits on is still unnamed.
# TBR-LINUX-01. Do not substitute network-online.target.
# After=systemd-networkd-wait-online@TBD.service
# Requires=systemd-networkd-wait-online@TBD.service

[Unit]
Description=OpenTAKServer capability
Documentation=file:///usr/share/doc/fml/tak
Wants=ots-network.service postgresql.service rabbitmq.service opentakserver.service eud-handler.service cot-parser.service

[Install]
WantedBy=multi-user.target
