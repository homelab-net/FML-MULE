# SQL backend for the TAK service. Not loadable: the suffix is
# .container.disabled. Image digest is the one recorded on 2026-08-31.
# No credential belongs in this file.

[Unit]
Description=PostgreSQL for the TAK service
Documentation=file:///usr/share/doc/fml/tak
After=network-online.target

[Container]
Image=docker.io/library/postgres@sha256:485935f94cc7165afa896978809c37b592dc07f0a37d2c8f645f12412d0212c8
Volume=/var/lib/fml/postgresql:/var/lib/postgresql/data:Z
EnvironmentFile=/run/fml/postgresql.env

[Service]
# No Restart=. TBR-HA-01 is open.

[Install]
WantedBy=multi-user.target
