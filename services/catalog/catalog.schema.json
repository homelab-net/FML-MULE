{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feral-mule.invalid/schema/service-catalog-1.0.json",
  "title": "FERAL MULE service catalog",
  "description": "The set of services approved to run on a node. FML-ADR-078.",
  "type": "object",
  "additionalProperties": false,
  "required": ["services"],
  "properties": {
    "services": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "tbd": { "const": "TBD" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "enabled",
        "aliases",
        "unit",
        "purpose",
        "image",
        "upstream",
        "rootless",
        "resource_envelope",
        "exposed_to",
        "durable_state",
        "recovery",
        "region_dependency",
        "adr"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Stable identifier used by the Quadlet unit and ingress.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "enabled": {
          "type": "boolean",
          "description": "True only when the referenced deployment unit exists and may be enabled by a mission."
        },
        "aliases": {
          "type": "array",
          "description": "Optional mission-package names that resolve uniquely to the canonical name.",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "unit": {
          "description": "Loadable Quadlet filename, or TBD while this is a disabled catalog contract.",
          "oneOf": [
            { "$ref": "#/$defs/tbd" },
            { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.container$" }
          ]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "image": {
          "description": "OCI reference by immutable digest, or TBD with the trade that will pin it named in a comment. A tag is never accepted.",
          "oneOf": [
            { "$ref": "#/$defs/tbd" },
            { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" }
          ]
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "url", "license"],
          "properties": {
            "project": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "license": { "type": "string", "minLength": 1 }
          }
        },
        "rootless": {
          "description": "true, or rootful with the reason recorded, or TBD.",
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/tbd" }]
        },
        "resource_envelope": {
          "description": "Measured memory and CPU under load (TBR-COMP-01), or TBD.",
          "oneOf": [
            { "$ref": "#/$defs/tbd" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["memory_mb", "cpu"],
              "properties": {
                "memory_mb": { "type": "number" },
                "cpu": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "exposed_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["node", "eud_ap", "mesh"] }
        },
        "durable_state": {
          "description": "true if state must survive node loss (TBR-TAK-01), false if not, TBD if undecided.",
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/tbd" }]
        },
        "recovery": {
          "description": "Approved recovery behavior, or TBD while TBR-HA-01 is open.",
          "type": "string",
          "minLength": 1
        },
        "region_dependency": {
          "description": "Whether the service implementation or configuration varies by regulatory region.",
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/tbd" }]
        },
        "adr": {
          "description": "Decision record approving the catalog contract.",
          "type": "string",
          "pattern": "^FML-ADR-[0-9]{3}$"
        }
      }
    }
  }
}
