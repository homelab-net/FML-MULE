# OpenTAKServer 1.7.13 as one image and three commands.
# FML-ADR-032 prefers the server. FML-ADR-029 requires a digest, never a tag.
# Upstream publishes no image, and its Dockerfile installs git master on
# Python 3.13. That base trips gevent. See
# docs/evidence/TBR-TAK-01/2026-08-31-opentakserver-actually-run.md.
#
# Base: the Python 3.12 bookworm multi-arch index, retrieved 2026-09-24 from
# registry-1.docker.io. The index digest is immutable. Each Quadlet sets
# Exec to one console script. This file does not set a command.

FROM docker.io/library/python@sha256:dbbe4ceb97851e2e5fa83798b239811f871cb743b259ba3563737349f6bcfaa0

RUN pip install --no-cache-dir "opentakserver==1.7.13"
